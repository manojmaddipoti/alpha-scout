# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Tavily Search API Configuration
TAVILY_API_KEY=your_tavily_api_key_here

# SEC EDGAR Identity (Required format: "Your Name your@email.com")
SEC_IDENTITY=Your Name your@email.com

# Application Password (For login authentication)
APP_PASSWORD=your_secure_password_here

# Database Path (Optional - defaults to /tmp/data/chat_history.db)
# DB_PATH=/tmp/data/chat_history.db
