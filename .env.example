# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Tavily Search API Configuration
TAVILY_API_KEY=your_tavily_api_key_here

# SEC EDGAR Identity (Required format: "Your Name your@email.com")
SEC_IDENTITY=Your Name your@email.com

# Optional comma-separated authorization allowlist.
# Authentication itself is configured in .streamlit/secrets.toml.
# ALLOWED_EMAILS=you@example.com,recruiter@example.com

# Model Overrides (Optional - defaults track current preferred model family)
OPENAI_MODEL=gpt-5.5
CLAUDE_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-3.1-pro

# Database Path (Optional - defaults to data/alpha_scout.db)
# DB_PATH=data/alpha_scout.db
